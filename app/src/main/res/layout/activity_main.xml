<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Joyose NoLimit"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="精准屏蔽温控限帧 · 零副作用 · 完整保留游戏工具箱"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginBottom="16dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● 正在检测模块状态..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#757575"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tv_mcddf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="/data/system/mcd/df: 检测中..."
                android:textSize="13sp"
                android:textColor="#424242"
                android:fontFamily="monospace"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_restart_joyose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="重启 JOYOSE 进程使 HOOK 生效 (需 ROOT)"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Interception Stats Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="温控限帧拦截统计"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

                <TextView
                    android:id="@+id/btn_reset_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="清空统计"
                    android:textSize="12sp"
                    android:textColor="#1976D2"
                    android:padding="6dp"
                    android:background="?android:attr/selectableItemBackground" />
            </LinearLayout>

            <!-- Counter Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:background="#F8FAFC"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tv_intercept_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="次"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#546E7A"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Recent Interception Box -->
            <TextView
                android:id="@+id/tv_recent_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="最近一次拦截："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#37474F"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_recent_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无拦截记录 (触发温控降频时自动拦截并计数)"
                android:textSize="12sp"
                android:textColor="#616161"
                android:lineSpacingExtra="4dp"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
