<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Joyose NoLimit"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="精准屏蔽温控限帧 · 零副作用 · 完整保留游戏工具箱"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginBottom="20dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● 正在检测模块状态..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#757575"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_mcddf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="/data/system/mcd/df: 检测中..."
                android:textSize="13sp"
                android:textColor="#424242"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_restart_joyose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="重启 Joyose 进程使 Hook 生效 (需 Root)"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Principle Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="工作原理与说明"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 精准拦截汇聚点：Joyose 所有动态温控与 PID 降频限帧，最终都统一汇聚到 com.xiaomi.joyose.utils.w (MiDFUtils) 的 f 与 g 方法。\n\n2. 阻断下发：本模块拦截对 /data/system/mcd/df 写入及向下游调度器广播，使系统底层永远保持满血帧率。\n\n3. 零功能破坏：不修改系统温控数据库，不停止 Joyose 核心服务。Game Turbo 侧边栏、画质增强、触控优化、游戏网络加速等功能 100% 完整保留。\n\n4. 验证方式：可在终端执行 logcat -s LSPosed-JoyoseNoLimit 观察拦截日志。"
                android:textSize="13sp"
                android:textColor="#616161"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
